{
  "experiment": "Continuous covariance evolution",
  "replications": 60,
  "design": {
    "n": 360,
    "d": 3,
    "fit_end": 160,
    "val_end": 240,
    "window_length": 16,
    "phi": 0.55,
    "ar_model": "full",
    "target_deltas": [0.0, 0.75, 1.50, 2.00],
    "horizons": [1, 3, 6],
    "ridge_grid": [0.001, 0.01, 0.1, 1.0],
    "seed_base": 31000000,
    "k_ref": 3,
    "refresh_period": 10,
    "reference_condition": 12.0,
    "covariance_nugget": 0.5,
    "cyclic_period": 30,
    "cyclic_amplitudes": [0.84, 0.672, 0.504],
    "cyclic_noise_dispersion": 0.002,
    "mean_reversion_controls": [0.70, 0.80, 0.90, 1.00],
    "fixed_center_cyclic_period": 60,
    "fixed_center_mean_cycle_period": 12,
    "fixed_center_mean_cycle_scale": 1.0,
    "mean_dispersion": 0.015,
    "regimes": ["persistent", "mean_reverting"],
    "minimum_generating_transport_eigenvalue": 0.12,
    "max_seed_resamples": 20,
    "seed_retry_stride": 10000000
  }
}
